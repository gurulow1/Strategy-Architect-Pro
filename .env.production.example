# Vercel environment variables — set in the Vercel project dashboard if needed.
#
# VITE_API_BASE is OPTIONAL when vercel.json is present.
# vercel.json already proxies /api/ai → Railway, so no env var is required.
# Only set this if you want to bypass the proxy and call Railway directly
# (e.g. from a staging environment or a different Vercel project).
#
# VITE_API_BASE=https://your-backend.up.railway.app
