GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
PORT=3001
PRODUCTION_ORIGIN=https://your-frontend.vercel.app

# License-key authentication (optional — omit both to run in open/demo mode)
#
# JWT_SECRET  — random secret for signing tokens; generate with:
#               node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# LICENSE_KEYS — JSON array of valid 32-char hex keys, e.g.:
#               ["a1b2c3d4e5f67890a1b2c3d4e5f67890","b2c3d4e5f67890a1b2c3d4e5f67890a1"]
#               Or a JSON object {"<key>":"<label>"} for labeled key management.
#               Generate a key with:
#               node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
JWT_SECRET=
LICENSE_KEYS=

# ── Telegram notifications (optional) ────────────────────────────────────────
# Create a bot via @BotFather and paste its token below. Leave blank to disable.
# TELEGRAM_WEBHOOK_URL is your PUBLIC backend origin (e.g. the Railway domain);
# the server appends /api/telegram/webhook and registers it on startup.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=https://your-railway-domain.railway.app
TG_STORE_PATH=./tg-store.json

# ── Broker import (optional) ─────────────────────────────────────────────────
# MetaTrader: shared secret the EA must send in the X-MT-Token header.
#   Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
MT_PUSH_TOKEN=
# cTrader Open API app credentials (https://connect.ctrader.com).
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
