# Local backend
NODE_ENV=development
PORT=3001
APP_MODE=license
ALLOWED_ORIGINS=http://localhost:5173

# OpenAI or OpenRouter Responses API.
# Direct OpenAI needs no base override and uses gpt-5-mini.
# sk-or-v1 keys are detected automatically and use openai/gpt-5-mini.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Optional explicit override. Only these exact bases are accepted:
# https://api.openai.com/v1
# https://openrouter.ai/api/v1
# https://eu.openrouter.ai/api/v1
OPENAI_BASE_URL=
# Per-account UTC daily caps protect availability and API spend.
AI_DAILY_LIMIT_LICENSE=200
AI_DAILY_LIMIT_TRIAL=20

# Access control
# Generate JWT_SECRET:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Generate a short activation key and its SHA-256 hash:
# node scripts/generate-license-key.mjs
# Store only the printed hash here, never the plaintext key.
LICENSE_KEY_HASHES=[]

# Production persistence. Railway PostgreSQL supplies DATABASE_URL.
# Without it, development uses the ignored local file below.
DATABASE_URL=
# TLS stays enabled. Keep certificate verification on unless the managed
# provider explicitly documents a private/self-signed certificate chain.
DATABASE_TLS_REJECT_UNAUTHORIZED=true
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
ACCESS_STORE_PATH=.data/access.json

# Optional Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# Experimental broker imports are hidden by default.
ENABLE_BETA_BROKERS=false
# Use a separate random value of at least 32 bytes when MetaTrader beta is enabled.
MT_PUSH_TOKEN=
